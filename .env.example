# Copy to .env.local (gitignored, never commit it).

# Read once at server startup to auto-create the admin account if none
# exists yet (see server/bootstrapAdmin.js). You can also skip these and
# run `npm run setup:admin` locally instead — either way works.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Set to "production" when deployed behind HTTPS (enables Secure cookies + HSTS)
NODE_ENV=development

# Optional
PORT=3000

# Only needed if your host's writable disk isn't the app directory itself
# (e.g. a Railway volume mounted at /data). Leave unset for local dev.
DATA_DIR=
